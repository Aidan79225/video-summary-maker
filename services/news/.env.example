# 複製成 .env 或寫進 systemd 的 Environment=。
# 這個檔案本身不會被程式讀取——Django 只看真正的環境變數。

# --- 一定要改的 ---
# 用這行產生：python -c "import secrets; print(secrets.token_urlsafe(64))"
# 沒設的話，DEBUG=False 時會直接拒絕啟動（不是警告，是拒絕）
DJANGO_SECRET_KEY=換成一串夠長的隨機字元
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,pi.local

# --- GPU 主機上的摘要 API ---
GPU_API_BASE=http://192.168.1.50:8800
GPU_API_KEY=
GPU_JOB_TIMEOUT_SECONDS=1800

# --- 匯入 ---
# 每次最多處理幾段發言。一段約 3～5 分鐘，20 段約 1～2 小時。
INGEST_DAILY_LIMIT=20
# 常駐排程每天幾點跑（台北時間）
INGEST_HOUR=4

# --- 其他 ---
DJANGO_DEBUG=False
# DJANGO_DB_PATH=/home/pi/ly-news/db.sqlite3
# DJANGO_MEDIA_ROOT=/home/pi/ly-news/media
# 前面掛了 nginx 的話設 False，讓 nginx 直接服務 /media
DJANGO_SERVE_MEDIA=True

# 後端 API base（結尾不要加斜線）
# SSR 在伺服器端用的位址，可以是 127.0.0.1
PUBLIC_API_BASE=http://localhost:8000

# 圖片網址會原樣送到瀏覽器，所以這裡要填「手機連得到」的位址。
# 沒設就沿用 PUBLIC_API_BASE（單機開發時兩者相同）。
# PUBLIC_MEDIA_BASE=http://pi.local:8000

# 假資料模式：設為 1 時完全不連後端，改讀 src/fixtures/sample.json
# 用於 Django 還沒起來、或要離線 demo 的時候
USE_FIXTURE=0

# API 逾時（毫秒），預設 8000
API_TIMEOUT_MS=8000

# 正式站給 node ./dist/server/entry.mjs 用
HOST=0.0.0.0
PORT=4321

---
import Base from '../layouts/Base.astro';
import Notice from '../components/Notice.astro';

Astro.response.status = 404;
---

<Base title="找不到頁面">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <Notice
      title="找不到這個頁面"
      body="網址可能打錯了，或這篇報導已經不存在。從首頁重新找找看吧。"
    />
  </div>
</Base>

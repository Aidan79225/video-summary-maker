---
import Base from '../../layouts/Base.astro';
import ArticleCardView from '../../components/ArticleCard.astro';
import Notice from '../../components/Notice.astro';
import Pagination from '../../components/Pagination.astro';
import ProfilePanel from '../../components/ProfilePanel.astro';
import { getArticles, getProfile, getSpeakers, statusFor } from '../../lib/api';
import { buildQuery, formatDateWithWeekday } from '../../lib/format';
import { isSource, memberKicker, memberTitle, sourceLabel } from '../../lib/sources';
import PartyBadge from '../../components/PartyBadge.astro';

const PAGE_SIZE = 12;

const raw = String(Astro.params.name ?? '');
let name = raw;
try {
  name = decodeURIComponent(raw);
} catch {
  name = raw;
}

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);
const rawSource = url.searchParams.get('source')?.trim() ?? '';
const source = isSource(rawSource) ? rawSource : '';

// 側寫的「看這 N 篇」帶這三個參數過來。會期只認正整數、開關只認 1／true：
// 亂打的當成沒篩，不要把後端的 422 傳染給整頁（跟 ?source= 同一個做法）。
const rawSession = url.searchParams.get('session')?.trim() ?? '';
const session = /^\d{1,9}$/.test(rawSession) && Number(rawSession) > 0 ? Number(rawSession) : 0;
const flag = (key: string) =>
  ['1', 'true'].includes(url.searchParams.get(key)?.trim().toLowerCase() ?? '');
const solo = flag('solo');
const brief = flag('brief');
const hasFilter = Boolean(session || solo || brief);

// 側寫要等名單回來才知道 person_id；文章清單先送出去，兩邊不必排隊
const listPromise = getArticles({
  speaker: name,
  source,
  session: session || undefined,
  solo,
  has_brief: brief,
  page,
  page_size: PAGE_SIZE,
});
const speakersRes = await getSpeakers(source);
const allSpeakers = speakersRes.ok ? speakersRes.data.items : [];
const me = allSpeakers.find((s) => s.name === name);

// 側寫失敗（含 404：這個人在這個來源還沒有統計）就整段不顯示，頁面其他部分照常。
// 網址指定了會期卻沒指定來源時不替它補來源：會期本身就決定了來源，交給後端
// 照會期挑；補上 me.source 反而可能跟會期對不上而變成 404。
const [listRes, profileRes] = await Promise.all([
  listPromise,
  me?.person_id
    ? getProfile(me.person_id, {
        source: source || (session ? undefined : me.source),
        session: session || undefined,
      })
    : Promise.resolve(null),
]);
const profile = profileRes?.ok ? profileRes.data : null;

if (!listRes.ok) {
  Astro.response.status = statusFor(listRes.error.kind);
}

const list = listRes.ok ? listRes.data : null;
const items = list?.items ?? [];
const others = allSpeakers.filter((s) => s.name !== name);
// 沒帶 ?source= 時，用這位發言者實際所屬的議會決定用語
const effectiveSource = source || me?.source || items[0]?.source || 'ly';
const title = memberTitle(effectiveSource);
const latest = me?.latest_date ?? items[0]?.date ?? '';
const total = me?.count ?? list?.count ?? 0;
const basePath = `/speaker/${encodeURIComponent(name)}`;
// 分頁要帶著目前的篩選。以前把 ?source= 直接寫進 base，
// Pagination 再接一個「?page=2」，翻頁網址就變成「?source=ly?page=2」。
const listParams = {
  source: source || undefined,
  session: session ? String(session) : undefined,
  solo: solo ? '1' : undefined,
  brief: brief ? '1' : undefined,
};
const retryHref = `${url.pathname}${url.search}`;
// 篩選相關的連結都帶 #articles：側寫區塊很高，不跳過去的話點了看起來像沒反應
const clearHref = `${basePath}${buildQuery({ source: source || undefined }, {})}#articles`;

// 會期名稱從側寫的會期清單查；查不到（側寫沒載入）就只寫編號，不猜
const sessionName =
  profile?.sessions.find((s) => s.id === session)?.name ?? (session ? `會期 #${session}` : '');
const chips = [
  session ? { key: 'session', label: `會期：${sessionName}` } : null,
  solo ? { key: 'solo', label: '只看單獨發言' } : null,
  brief ? { key: 'brief', label: '只看有摘要卡的' } : null,
].filter(Boolean) as { key: string; label: string }[];
---

<Base
  title={name}
  description={`${name}${title}在${sourceLabel(effectiveSource)}的質詢報導整理。`}
  back={true}
>
  <section class="border-b border-line-soft bg-bg-soft/60">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
      <p class="text-[0.7rem] tracking-[0.3em] text-accent uppercase">
        {memberKicker(effectiveSource)} · {sourceLabel(effectiveSource)}
      </p>
      <h1 class="headline mt-3 text-3xl font-semibold sm:text-4xl">{name}</h1>
      {
        (me?.party || me?.district) && (
          <p class="mt-3 flex flex-wrap items-center gap-2 text-sm text-muted">
            <PartyBadge party={me?.party} full={true} />
            {me?.district && <span>{me.district}</span>}
          </p>
        )
      }
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
        {total > 0 && <span class="tabular">共 {total} 篇報導</span>}
        {
          latest && (
            <>
              {total > 0 && (
                <span aria-hidden="true" class="text-line">
                  ·
                </span>
              )}
              <span class="tabular">最近一次：{formatDateWithWeekday(latest)}</span>
            </>
          )
        }
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    {
      profile && (
        <div class="mb-10">
          <ProfilePanel profile={profile} basePath={basePath} />
        </div>
      )
    }

    <div id="articles" class="scroll-mt-20" aria-hidden="true"></div>

    {
      hasFilter && (
        <div class="mb-6 flex flex-wrap items-center gap-2 rounded-[var(--radius-card)] border border-line bg-surface/70 px-4 py-3">
          <span class="text-[0.72rem] text-muted">目前篩選</span>
          {chips.map((c) => (
            <a
              href={`${basePath}${buildQuery(listParams, { [c.key]: undefined })}#articles`}
              class="group inline-flex items-center gap-1.5 rounded-full border border-line bg-bg-soft px-2.5 py-1 text-[0.72rem] text-ink-2 transition-colors hover:border-danger hover:text-danger"
              title="移除這個條件"
            >
              <span class="sr-only">移除條件：</span>
              {c.label}
              <span aria-hidden="true" class="text-muted group-hover:text-danger">
                ×
              </span>
            </a>
          ))}
          {list && <span class="tabular text-[0.72rem] text-muted">共 {list.count} 篇</span>}
          <a
            href={clearHref}
            class="ml-auto rounded-full border border-line px-3 py-1 text-[0.75rem] text-muted transition-colors hover:border-danger hover:text-danger"
          >
            清除
          </a>
          {solo && brief && (
            <p class="w-full text-[0.72rem] leading-relaxed text-muted">
              具體度只用這些報導計算：聯合質詢的摘要卡分不出是誰講的，沒有摘要卡的報導沒有可數的東西。
            </p>
          )}
        </div>
      )
    }

    {!listRes.ok && <Notice error={listRes.error} retryHref={retryHref} />}

    {
      listRes.ok &&
        items.length === 0 &&
        (hasFilter ? (
          <Notice
            title="這個篩選條件下沒有報導"
            body="這個會期可能還沒有符合條件的報導，或報導還在處理中。按上面的「清除」可以看這位發言者的全部報導。"
          />
        ) : (
          <Notice
            title={`目前沒有 ${name} 的報導`}
            body={`可能是姓名有誤，或這位${title}的質詢還沒有被整理。可以回首頁看看其他人。`}
            retryHref="/"
          />
        ))
    }

    {
      items.length > 0 && (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((a, i) => (
            <ArticleCardView article={a} index={i} eager={i < 3} />
          ))}
        </div>
      )
    }

    {list && <Pagination page={list.page} pages={list.pages} base={basePath} params={listParams} hash="articles" />}

    {
      others.length > 0 && (
        <section class="mt-16 border-t border-line-soft pt-8">
          <h2 class="mb-4 text-[0.72rem] tracking-[0.2em] text-muted uppercase">其他{title}</h2>
          <div class="flex flex-wrap gap-2">
            {others.map((s) => (
              <a
                href={`/speaker/${encodeURIComponent(s.name)}?source=${s.source}`}
                class="lift rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-ink-2 hover:border-accent hover:text-accent"
              >
                {s.name}
                <span class="tabular ml-1 text-[0.7rem] text-muted">{s.count}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

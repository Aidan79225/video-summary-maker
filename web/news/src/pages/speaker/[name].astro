---
import Base from '../../layouts/Base.astro';
import ArticleCardView from '../../components/ArticleCard.astro';
import Notice from '../../components/Notice.astro';
import Pagination from '../../components/Pagination.astro';
import { getArticles, getSpeakers, statusFor } from '../../lib/api';
import { formatDateWithWeekday } from '../../lib/format';

const PAGE_SIZE = 12;

const raw = String(Astro.params.name ?? '');
let name = raw;
try {
  name = decodeURIComponent(raw);
} catch {
  name = raw;
}

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get('page')) || 1);

const [listRes, speakersRes] = await Promise.all([
  getArticles({ speaker: name, page, page_size: PAGE_SIZE }),
  getSpeakers(),
]);

if (!listRes.ok) {
  Astro.response.status = statusFor(res.error.kind);
}

const list = listRes.ok ? listRes.data : null;
const items = list?.items ?? [];
const others = (speakersRes.ok ? speakersRes.data.items : []).filter((s) => s.name !== name);
const me = (speakersRes.ok ? speakersRes.data.items : []).find((s) => s.name === name);
const latest = me?.latest_date ?? items[0]?.date ?? '';
const total = me?.count ?? list?.count ?? 0;
const base = `/speaker/${encodeURIComponent(name)}`;
const retryHref = `${url.pathname}${url.search}`;
---

<Base title={name} description={`${name}委員在立法院的質詢報導整理。`} back={true}>
  <section class="border-b border-line-soft bg-bg-soft/60">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
      <p class="text-[0.7rem] tracking-[0.3em] text-accent uppercase">Legislator</p>
      <h1 class="headline mt-3 text-3xl font-semibold sm:text-4xl">{name}</h1>
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
        {total > 0 && <span class="tabular">共 {total} 篇報導</span>}
        {
          latest && (
            <>
              {total > 0 && (
                <span aria-hidden="true" class="text-line">
                  ·
                </span>
              )}
              <span class="tabular">最近一次：{formatDateWithWeekday(latest)}</span>
            </>
          )
        }
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    {!listRes.ok && <Notice error={listRes.error} retryHref={retryHref} />}

    {
      listRes.ok && items.length === 0 && (
        <Notice
          title={`目前沒有 ${name} 的報導`}
          body="可能是姓名有誤，或這位委員的質詢還沒有被整理。可以回首頁看看其他委員。"
          retryHref="/"
        />
      )
    }

    {
      items.length > 0 && (
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((a, i) => (
            <ArticleCardView article={a} index={i} eager={i < 3} />
          ))}
        </div>
      )
    }

    {list && <Pagination page={list.page} pages={list.pages} base={base} />}

    {
      others.length > 0 && (
        <section class="mt-16 border-t border-line-soft pt-8">
          <h2 class="mb-4 text-[0.72rem] tracking-[0.2em] text-muted uppercase">其他委員</h2>
          <div class="flex flex-wrap gap-2">
            {others.map((s) => (
              <a
                href={`/speaker/${encodeURIComponent(s.name)}`}
                class="lift rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-ink-2 hover:border-accent hover:text-accent"
              >
                {s.name}
                <span class="tabular ml-1 text-[0.7rem] text-muted">{s.count}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>

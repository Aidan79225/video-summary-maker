---
/**
 * 方法說明：網站上每一個「算出來的數字」怎麼來的。
 *
 * 側寫的可信度全靠這一頁——公式寫在這裡，任何人拿同樣的資料都能算出同樣的
 * 結果；限制也寫在這裡，讀者才知道哪些數字不能拿來做什麼。寫給一般讀者看，
 * 不用程式欄位名稱，用「篇」「個數字」這種看得懂的字。
 *
 * 內容要跟後端的計算（services/news 的 compute_profiles）一致；改公式時兩邊一起改。
 * 院內紀錄的指標名稱與分組來自 lib/records.ts，跟側寫上的卡片同一份。
 */
import Base from '../layouts/Base.astro';
import {
  COMMITTEE_AREAS,
  TOPIC_AREAS,
  TOPIC_BREADTH_SHARE,
  TOPIC_MIN_ACCURACY,
  TOPIC_MIN_LABELS,
  topicLabel,
} from '../lib/topics';
import { CHAMBER_GROUPS, CHAMBER_INDICATORS } from '../lib/records';

const toc = [
  { id: 'profile-principles', label: '原則' },
  { id: 'profile-sessions', label: '會期與同儕' },
  { id: 'profile-volume', label: '投入量' },
  { id: 'profile-specificity', label: '具體度' },
  { id: 'profile-topics', label: '議題分布' },
  { id: 'profile-chamber', label: '院內紀錄' },
  { id: 'profile-joint', label: '聯合質詢' },
  { id: 'profile-percentile', label: '百分位' },
  { id: 'profile-sample', label: '最小樣本' },
  { id: 'profile-limits', label: '資料限制' },
  { id: 'profile-todo', label: '還沒做的指標' },
];

// 公式框與小標的樣式集中在這裡，各節才會長得一樣
const h3 = 'headline mt-12 scroll-mt-24 text-lg font-semibold text-ink sm:text-xl';
// 議題分布的內容多，在 h3 底下再分幾個小節
const h4 = 'mt-8 scroll-mt-24 text-[0.95rem] font-semibold text-ink';
const th = 'py-2 pr-3 font-medium';
// 門檻寫成讀者看得懂的字，跟頁面上的「準確率 85%」同一種寫法
const minAccuracy = `${Math.round(TOPIC_MIN_ACCURACY * 100)}%`;
const formula =
  'my-4 rounded-xl border border-line-soft bg-bg-soft/60 px-4 py-3 text-[0.92rem] leading-relaxed text-ink';
const term = 'font-semibold text-ink';
const list = 'mt-3 grid list-disc gap-2 pl-5 marker:text-muted';

// 院內紀錄八個指標的公式；名稱與單位照 CHAMBER_INDICATORS，跟側寫上的卡片一致
const CHAMBER_FORMULAS: Record<string, string> = {
  plenary_attendance: '出席名單上有他的院會場數 ÷ 他在任期間的院會場數 × 100',
  committee_attendance: '出席名單上有他的委員會會議場數 ÷ 他那個會期所屬委員會、在他任期內的會議場數 × 100',
  bills_proposed: '他列名提案人的委員提案件數',
  bills_cosigned: '他列名連署人的委員提案件數',
  bills_passed: '他列名提案人、而且議案狀態含「三讀」的委員提案件數',
  vote_participation: '他有投票的記名表決次數 ÷ 他在任期間的記名表決次數 × 100',
  caucus_agreement: '他的票跟所屬黨團多數相同的次數 ÷ 他有投票、而且黨團有多數的記名表決次數 × 100',
  caucus_defections: '他有投票、黨團有多數，而他的票跟黨團多數不同的記名表決次數',
};
---

<Base
  title="方法說明"
  description="人物側寫的每個指標怎麼算：原則、公式、會期與同儕的定義、議題分類與人工標註、百分位、最小樣本與資料限制。"
  back={true}
>
  <section class="border-b border-line-soft bg-bg-soft/60">
    <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-12">
      <p class="text-[0.7rem] tracking-[0.3em] text-accent uppercase">Method</p>
      <h1 class="headline mt-3 text-3xl font-semibold sm:text-4xl">方法說明</h1>
      <p class="mt-4 text-sm leading-relaxed text-muted sm:text-base">
        網站上每一個算出來的數字，公式都寫在這一頁。任何人拿同樣的資料，都應該算出同樣的結果；算不出來，就是我們錯了。
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <section id="profile" class="scroll-mt-24" aria-labelledby="profile-heading">
      <h2 id="profile-heading" class="headline text-2xl font-semibold sm:text-[1.7rem]">人物側寫</h2>
      <div class="prose-cn mt-4">
        <p>
          發言者頁上的「人物側寫」回答三件事：這位民意代表在一個會期裡<strong class={term}>發言了多少</strong>、他的質詢<strong
            class={term}>講得多具體</strong>，以及他<strong class={term}>問的是哪些議題</strong>。每個數字都跟同一個議會、同一個會期的人放在一起看，讓讀者知道他落在哪一段。
        </p>
        <p class="mt-3">立委另外有一塊<strong class={term}>院內紀錄</strong>：出席、提案與記名表決，資料直接來自立法院（見「院內紀錄」）。</p>
        <p class="mt-3">側寫不是評分。這一頁的公式算出來的是計數與比例，不是好壞。</p>
      </div>

      <nav class="mt-6 rounded-xl border border-line bg-surface px-4 py-3" aria-label="這一節的目錄">
        <p class="text-[0.7rem] tracking-[0.2em] text-muted">目錄</p>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5 text-sm">
          {
            toc.map((t) => (
              <li>
                <a href={`#${t.id}`} class="text-ink-2 underline decoration-line underline-offset-4 hover:text-accent">
                  {t.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- 原則 -->
      <h3 id="profile-principles" class={h3}>原則</h3>
      <ol class="prose-cn mt-3 grid list-decimal gap-2.5 pl-5 marker:text-muted">
        <li>
          <strong class={term}>不加總、不排名。</strong>沒有總分，也沒有排行榜。每個指標各自顯示，怎麼權衡由讀者決定——各項權重怎麼配都是一種立場，所以我們不配。
        </li>
        <li>
          <strong class={term}>只跟同儕比。</strong>立委只跟立委比，臺中市議員只跟臺中市議員比，新北市議員只跟新北市議員比，而且只比同一個會期。各議會的質詢制度不同，放在一起比沒有意義。
        </li>
        <li>
          <strong class={term}>數字由程式按公式算。</strong>每個指標都是從既有資料直接計數或相除，公式就寫在下面。模型不給數字：具體度用到的摘要卡是語言模型從逐字稿抽取、再由程式逐一檢查過的（見「具體度」）；議題分布用到模型分類，但模型只負責把每篇報導分到一個固定的領域，篇數、占比都是程式數的（見「議題分布」）。
        </li>
        <li>
          <strong class={term}>模型參與的指標要先過人工標註。</strong>議題分類要先在一份人工標註的報導上達到準確率門檻，那個議會的議題分布才會出現；換模型或改提示詞就要重新評估。
        </li>
        <li>
          <strong class={term}>樣本太少就不比較。</strong>具體度與議題分布的分母不到 5 時只顯示原始的值，不跟別人比（見「最小樣本」）。
        </li>
        <li>
          <strong class={term}>每個數字都能點回去。</strong>指標底下的「看這 12 篇」，列出的就是算出這個數字的那 12 篇報導。
        </li>
      </ol>

      <!-- 會期與同儕 -->
      <h3 id="profile-sessions" class={h3}>會期與同儕</h3>
      <div class="prose-cn mt-3">
        <p>
          <strong class={term}>會期</strong>從每篇報導的會議名稱讀出來：
        </p>
      </div>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full border-collapse text-left text-[0.85rem]">
          <thead>
            <tr class="border-b border-line text-[0.75rem] text-muted">
              <th scope="col" class="py-2 pr-3 font-medium">來源</th>
              <th scope="col" class="py-2 pr-3 font-medium">會議名稱（例）</th>
              <th scope="col" class="py-2 font-medium">算在哪個會期</th>
            </tr>
          </thead>
          <tbody class="text-ink-2">
            <tr class="border-b border-line-soft align-top">
              <td class="py-2 pr-3 whitespace-nowrap">立法院</td>
              <td class="py-2 pr-3">第11屆第5會期財政委員會第3次全體委員會議</td>
              <td class="py-2">第11屆第5會期</td>
            </tr>
            <tr class="border-b border-line-soft align-top">
              <td class="py-2 pr-3 whitespace-nowrap">立法院</td>
              <td class="py-2 pr-3">第11屆第3會期第1次臨時會第2次會議</td>
              <td class="py-2">第11屆第3會期（臨時會併入它所屬的會期）</td>
            </tr>
            <tr class="border-b border-line-soft align-top">
              <td class="py-2 pr-3 whitespace-nowrap">臺中市議會</td>
              <td class="py-2 pr-3">第4屆第8次定期會、第4屆第2次臨時會</td>
              <td class="py-2">原樣：定期會與臨時會各自是一期</td>
            </tr>
            <tr class="align-top">
              <td class="py-2 pr-3 whitespace-nowrap">新北市議會</td>
              <td class="py-2 pr-3">第4屆第8次定期會 市政總質詢</td>
              <td class="py-2">第4屆第8次定期會</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="prose-cn">
        <ul class={list}>
          <li>讀不出會期的報導（例如立法院的「朝野黨團協商」）不掛會期，不計入任何指標。</li>
          <li>
            側寫上的<strong class={term}>「資料涵蓋」</strong>不是官方的會期起訖，而是掛在這個會期的報導最早與最晚的日期。同一個會期裡，每個人的涵蓋範圍都一樣，比較才公平。
          </li>
          <li>
            <strong class={term}>同儕</strong>（比較的母體）是同一個議會裡、同一屆，任期跟這個會期的資料涵蓋範圍有重疊的所有民意代表——<strong
              class={term}>包括一次都沒有發言的人</strong>，他們的發言次數就是 0，這正是要比較的。
          </li>
          <li>
            新北市議會的議長、副議長不列入同儕：他們主持會議、不質詢，放進來只會多一排零。看的是那一屆的職務，下一屆才當選議長的人，這一屆仍照常計算。立法院與臺中市議會的名冊沒有記職務，因此沒有排除任何人。
          </li>
          <li>同一個人在會期中換了政黨，或連任到下一屆，名冊上會分成兩段任期，但側寫把他當成同一個人計算。</li>
          <li>報導的講者要對得到議會名冊上的任期（同一個議會、同一個名字、任期涵蓋發言日期）才算進他的側寫。</li>
        </ul>
      </div>

      <!-- 投入量 -->
      <h3 id="profile-volume" class={h3}>投入量</h3>
      <div class="prose-cn mt-3">
        <p>這個會期發言了幾次、講了多久。</p>
      </div>
      <div class={formula}>
        <p><span class={term}>發言次數</span>（次）＝ 這個會期裡，講者包含他的報導篇數</p>
      </div>
      <div class={formula}>
        <p>
          <span class={term}>發言總時長</span>（分鐘）＝ 每篇「影片長度〔秒〕÷ 該篇的講者人數」的總和 ÷ 60，取到小數一位
        </p>
      </div>
      <div class="prose-cn">
        <ul class={list}>
          <li>投入量沒有分母，不套最小樣本；但同儕不到 5 人時不給百分位。</li>
          <li>發言總時長是用取到小數一位之後的分鐘數跟同儕比：頁面上分鐘數一樣的人，就是同值。</li>
          <li>
            市議會的側寫把時長放在前面：總質詢一次幾十分鐘、業務質詢十幾分鐘，時長比次數更能反映投入。立法院則次數在前。
          </li>
        </ul>
      </div>

      <!-- 具體度 -->
      <h3 id="profile-specificity" class={h3}>具體度</h3>
      <div class="prose-cn mt-3">
        <p>
          具體度只看<strong class={term}>基礎報導</strong>：這個會期、已經完成、<strong class={term}>他單獨發言</strong>、而且<strong
            class={term}>有摘要卡</strong>的報導。
        </p>
      </div>
      <div class={formula}>
        <p><span class={term}>每篇落地數字數</span>（個／篇）＝ 基礎報導的關鍵數字總數 ÷ 基礎報導篇數</p>
      </div>
      <div class={formula}>
        <p>
          <span class={term}>每篇帶期限的要求數</span>（項／篇）＝ 基礎報導中「有寫期限」的要求總數 ÷ 基礎報導篇數
        </p>
      </div>
      <div class={formula}>
        <p>
          <span class={term}>有來源的數字占比</span>（%）＝ 附有條文原文的關鍵數字個數 ÷ 關鍵數字總數 × 100
        </p>
      </div>
      <div class="prose-cn">
        <ul class={list}>
          <li>
            <strong class={term}>摘要卡</strong>是每篇報導最上面那張卡：一句話、關鍵數字、要求與回應。它由語言模型從逐字稿抽取，程式再逐一檢查每個關鍵數字引用的那句話是不是真的出現在逐字稿裡，找不到的就丟掉。所以「落地數字」是講者真的講出口、在逐字稿裡查得到的數字；空泛的發言，這一項就是零。
          </li>
          <li>前兩項的 n 是基礎報導的篇數；有來源占比的 n 是關鍵數字的個數。n 是 0 時沒有值，顯示「—」。</li>
          <li>
            <strong class={term}>「有來源」目前的意思很窄：</strong>這個數字是在講某一條法律，而且我們抓得到那一條的條文原文。它說的是「有沒有附出處」，不是「講得對不對」。預算書、統計資料這類出處還沒有接上，所以這一項普遍偏低是正常的。
          </li>
        </ul>
      </div>

      <!-- 議題分布 -->
      <h3 id="profile-topics" class={h3}>議題分布</h3>
      <div class="prose-cn mt-3">
        <p>
          議題分布回答「他的質詢集中在哪些政策領域」。每篇報導由語言模型從 {TOPIC_AREAS.length} 個固定的領域裡選一個<strong
            class={term}>主領域</strong>；各領域的篇數、占比，以及下面三個指標，都是程式從這些分類數出來的。模型只做分類，不給數字。
        </p>
      </div>

      <h4 id="profile-topics-areas" class={h4}>{TOPIC_AREAS.length} 個領域</h4>
      <div class="prose-cn mt-2">
        <p>
          領域的清單寫在程式裡，模型只能從這幾個裡面選，不能自己發明新的。「包含」那一欄就是給模型看的說明。
        </p>
      </div>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full border-collapse text-left text-[0.85rem]">
          <thead>
            <tr class="border-b border-line text-[0.75rem] text-muted">
              <th scope="col" class={th}>領域</th>
              <th scope="col" class="py-2 font-medium">包含</th>
            </tr>
          </thead>
          <tbody class="text-ink-2">
            {
              TOPIC_AREAS.map((t, i) => (
                <tr class:list={['align-top', i < TOPIC_AREAS.length - 1 && 'border-b border-line-soft']}>
                  <th scope="row" class="py-2 pr-3 font-normal whitespace-nowrap text-ink">
                    {t.label}
                  </th>
                  <td class="py-2">{t.description}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h4 id="profile-topics-input" class={h4}>模型讀的是什麼</h4>
      <div class="prose-cn mt-2">
        <p>不是整份逐字稿，而是摘要卡的一句話加上各段的小標：</p>
      </div>
      <pre
        class="my-4 overflow-x-auto rounded-xl border border-line-soft bg-bg-soft/60 px-4 py-3 font-sans text-[0.88rem] leading-relaxed whitespace-pre-wrap text-ink">一句話：……
各段小標：
- ……
- ……</pre>
      <div class="prose-cn">
        <ul class={list}>
          <li>
            <strong class={term}>不放會議名稱。</strong>「財政委員會」幾個字幾乎會直接決定答案：模型會照會議分類，而不是照他問了什麼。而且立委的「委員會職掌內的比例」就會變成拿委員會去比委員會，自己比自己，一定很高。
          </li>
          <li>
            <strong class={term}>不讀整份逐字稿。</strong>一句話與小標已經是整段質詢的重點；逐字稿長、雜訊多，分類反而不穩，也慢得多。
          </li>
          <li>
            <strong class={term}>只分類基礎報導：</strong>已經完成、<strong class={term}>他單獨發言</strong>、而且<strong
              class={term}>有摘要卡</strong>的報導——跟具體度同一批。聯合質詢分不出每個人問了哪個議題；沒有摘要卡就沒有一句話可讀。
          </li>
          <li>
            模型選主領域的依據是「這段質詢主要在問什麼」。它也可以多給一個<strong class={term}>次領域</strong>（第二個領域占了相當篇幅時才給），但目前的數字只用主領域，次領域不計入。
          </li>
          <li>報導重新產生（例如摘要卡更新）之後，會重新分類一次。</li>
        </ul>
      </div>

      <h4 id="profile-topics-labels" class={h4}>人工標註與門檻</h4>
      <div class="prose-cn mt-2">
        <p>模型會分錯，所以分類器要先跟人工的答案比過，準確率夠高才用。</p>
        <ul class={list}>
          <li>
            每個議會從可以分類的報導裡<strong class={term}>隨機抽一批</strong>（目前每個議會 20 篇；用固定的亂數種子，同樣的資料抽出來的會是同樣幾篇），由人工標主領域。標註的人看到的就是模型讀的那段文字，而且<strong
              class={term}>看不到模型的答案</strong>，免得被它帶著走。
          </li>
          <li>評估時，把標過的報導用現在的模型與提示詞重新分類，逐篇跟人工的主領域比對。</li>
        </ul>
      </div>
      <div class={formula}>
        <p><span class={term}>準確率</span>（%）＝ 模型的主領域跟人工標註相同的篇數 ÷ 人工標註的篇數 × 100</p>
        <p class="mt-2">
          <span class={term}>通過</span> ＝ 人工標註至少 {TOPIC_MIN_LABELS} 篇，而且準確率至少 {minAccuracy}
        </p>
      </div>
      <div class="prose-cn">
        <ul class={list}>
          <li>每個議會各自評估、各自上線：立法院通過了，不代表臺中市議會、新北市議會也通過。</li>
          <li>
            側寫上那一行「分類器在 N 篇人工標註上的準確率 X%」，就是這個議會最近一次通過的評估結果；底下也寫了分類器的名稱（模型與提示詞的版本）與評估日期。
          </li>
        </ul>
      </div>

      <h4 id="profile-topics-live" class={h4}>什麼時候上線</h4>
      <div class="prose-cn mt-2">
        <ul class={list}>
          <li>
            一個議會的議題指標，<strong class={term}>只用最近一次通過評估的那個分類器</strong>（同一個模型、同一版提示詞）分出來的結果。
          </li>
          <li>這個議會還沒有通過的評估：側寫上就沒有「議題分布」這一塊，不是顯示 0。</li>
          <li>
            換了模型或改了提示詞：新分出來的結果跟通過的版本不同，<strong class={term}>不算</strong>，直到重新評估通過為止。所以頁面上寫的準確率，永遠是正在用的那個分類器的準確率。
          </li>
        </ul>
      </div>

      <h4 id="profile-topics-formulas" class={h4}>公式</h4>
      <div class="prose-cn mt-2">
        <p>
          這裡的<strong class={term}>基礎報導</strong>是：這個會期、已經完成、他單獨發言、有摘要卡，而且已經由通過評估的分類器分過類的報導。
        </p>
      </div>
      <div class={formula}>
        <p><span class={term}>領域占比</span>（%）＝ 主領域是這個領域的基礎報導篇數 ÷ 基礎報導篇數 × 100</p>
      </div>
      <div class={formula}>
        <p><span class={term}>聚焦度</span>（%）＝ 最大的領域占比</p>
        <p class="mt-2 text-[0.85rem] text-muted">例：9 篇基礎報導裡有 4 篇是國防外交，而且沒有別的領域比它多，聚焦度 ＝ 4 ÷ 9 × 100 ≈ 44.4%。</p>
      </div>
      <div class={formula}>
        <p><span class={term}>廣度</span>（個）＝ 占比至少 {TOPIC_BREADTH_SHARE}% 的領域有幾個</p>
      </div>
      <div class={formula}>
        <p>
          <span class={term}>委員會職掌內的比例</span>（%，只有立委）＝ 主領域落在他那個會期所屬委員會職掌內的基礎報導篇數 ÷ 有委員會資料的基礎報導篇數 × 100
        </p>
      </div>
      <div class="prose-cn">
        <ul class={list}>
          <li>
            分布列出每個領域的篇數與占比，點一個領域就是主領域是它的那幾篇；0 篇的領域收成一行，不畫長條。分布本身不跟同儕比，沒有百分位。
          </li>
          <li>
            三個指標的 n 是基礎報導的篇數（委員會職掌內的比例是有委員會資料的篇數），都套最小樣本、跟同儕比百分位（見「百分位」「最小樣本」）。
          </li>
          <li>
            聚焦度高不代表比較好，廣度高也不代表比較好：專攻一個領域，跟什麼都問，是兩種不同的問政方式。側寫只描述，不評價。
          </li>
        </ul>
      </div>

      <h4 id="profile-topics-committees" class={h4}>委員會職掌對照（立委）</h4>
      <div class="prose-cn mt-2">
        <p>「委員會職掌內的比例」用這張表判斷一個領域在不在委員會的職掌裡。表是我們訂的，寫在程式裡：</p>
      </div>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full border-collapse text-left text-[0.85rem]">
          <thead>
            <tr class="border-b border-line text-[0.75rem] text-muted">
              <th scope="col" class={th}>委員會</th>
              <th scope="col" class="py-2 font-medium">職掌內的領域</th>
            </tr>
          </thead>
          <tbody class="text-ink-2">
            {
              COMMITTEE_AREAS.map((c, i) => (
                <tr class:list={['align-top', i < COMMITTEE_AREAS.length - 1 && 'border-b border-line-soft']}>
                  <th scope="row" class="py-2 pr-3 font-normal text-ink">
                    {c.committee}
                  </th>
                  <td class="py-2">{c.areas.map(topicLabel).join('、')}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="prose-cn">
        <ul class={list}>
          <li>
            委員會資料來自立法院開放資料的委員資料，按會期記錄（例如「第11屆第5會期：財政委員會」）。看的是<strong
              class={term}>發言那個會期</strong>他所屬的委員會；同一個會期屬於不只一個委員會時，任何一個的職掌涵蓋就算。
          </li>
          <li>會期對不上、或查不到他那個會期委員會資料的報導，不算進分母。完全查不到時，頁面寫「沒有他這個會期的委員會資料」，不給數字。</li>
          <li>
            同一個領域可能分屬幾個委員會，例如環境能源同時在經濟委員會與社會福利及衛生環境委員會的職掌裡，表上兩邊都列。
          </li>
          <li>市議員沒有對應的公開資料，不算這一項。</li>
        </ul>
      </div>

      <h4 id="profile-topics-limits" class={h4}>限制</h4>
      <div class="prose-cn mt-2">
        <ul class={list}>
          <li>
            <strong class={term}>模型會分錯。</strong>門檻是 {minAccuracy}：剛好過門檻的分類器，大約每 5 篇就有 1 篇分錯。看分布的大致形狀比看單一篇可靠；單一篇的領域，請以報導內容為準。
          </li>
          <li>
            <strong class={term}>準確率本身也有誤差。</strong>標註集每個議會只有 {TOPIC_MIN_LABELS} 篇左右，{TOPIC_MIN_LABELS} 篇裡多錯 1 篇，準確率就差 {100 / TOPIC_MIN_LABELS} 個百分點。
          </li>
          <li>
            <strong class={term}>只算單獨發言、有摘要卡的報導。</strong>聯合質詢與還沒有摘要卡的舊報導都不在裡面，所以分布的篇數可能比發言次數少很多。
          </li>
          <li>
            <strong class={term}>一篇只算一個主領域。</strong>一段質詢常常跨好幾個領域，次領域目前不計入。
          </li>
          <li>
            <strong class={term}>「地方建設／其他」是兜底的領域。</strong>以上都不是的也歸在這裡，它偏高不一定代表特別關心地方建設。
          </li>
          <li>
            <strong class={term}>領域的界線是我們定的。</strong>跨領域的事（例如能源既是產業也是環境）放在哪一個，以上面那張表的說明為準；換一套分法，數字就會不同。
          </li>
        </ul>
      </div>

      <!-- 院內紀錄（立委） -->
      <h3 id="profile-chamber" class={h3}>院內紀錄（立委）</h3>
      <div class="prose-cn mt-3">
        <p>
          院內紀錄回答「他在立法院裡做了什麼」：出席了多少會議、提了多少案、記名表決怎麼投。資料全部是立法院公開的結構化紀錄，由程式直接計數，<strong
            class={term}>沒有模型參與</strong>。只有立委有：市議會沒有逐人、結構化的出席與表決資料。
        </p>
      </div>

      <h4 id="profile-chamber-sources" class={h4}>資料來源與同步</h4>
      <div class="prose-cn mt-2">
        <ul class={list}>
          <li>
            來源是立法院的開放資料，經 <a
              href="https://ly.govapi.tw/"
              rel="noopener noreferrer"
              target="_blank"
              class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent">LYAPI</a
            > 整理成結構化的格式：<strong class={term}>會議</strong>（院會與委員會，每一場的出席委員名單）、<strong class={term}>議案</strong>（委員提案的提案人、連署人與議案狀態）、<strong
              class={term}>表決</strong>（記名表決裡每位委員投了贊成、反對還是棄權）。
          </li>
          <li>
            <strong class={term}>每週日同步一次</strong>，排在更新委員名冊之後；同步完重算側寫。只要有一頁資料抓不到，那一次就整個不更新，不會只更新一半。
          </li>
          <li>
            每個數字底下的連結，列出算它用的每一筆紀錄：出席率列出每一場會議與他有沒有出席，提案列出每一件議案，表決列出每一次他投了什麼、他的黨團多數投了什麼。議案附官方的議案頁；會議與表決列出日期、名稱與會議代碼，有官方頁面的也附連結。
          </li>
          <li>
            紀錄上的名字跟委員名冊比對前，會先去掉空白、統一間隔號的寫法（原住民族委員的名字常有這種差異）。
          </li>
        </ul>
      </div>

      <h4 id="profile-chamber-tenure" class={h4}>在任期間、會期與同儕</h4>
      <div class="prose-cn mt-2">
        <ul class={list}>
          <li>
            每個指標都<strong class={term}>只算他在任期間</strong>：任期的起訖用立法院資料裡的到職日與離職日。會期中途才就任（例如遞補）或中途離職的人，分母只有他在任時開的會、做的表決；他不在任的那幾場不算缺席。
          </li>
          <li>每筆紀錄都標了屆別與會期（例如第11屆第5會期），那就是側寫上的會期。</li>
          <li>
            同儕是同一個會期的全體立委。出席率、投票出席率與黨團一致率這三個比例，只跟分母也夠大（至少 5）的人比；主提案、連署、三讀與跨黨投票是計數，跟全體比。百分位的算法跟其他指標一樣（見「百分位」）。
          </li>
        </ul>
      </div>

      <h4 id="profile-chamber-formulas" class={h4}>公式</h4>
      {
        CHAMBER_GROUPS.map((g) => (
          <div class={formula}>
            {CHAMBER_INDICATORS.filter((i) => i.group === g.key).map((i, idx) => (
              <p class:list={[idx > 0 && 'mt-2']}>
                <span class={term}>{i.label}</span>（{i.unit}）＝ {CHAMBER_FORMULAS[i.key]}
              </p>
            ))}
          </div>
        ))
      }
      <div class="prose-cn">
        <ul class={list}>
          <li>
            <strong class={term}>委員會</strong>指的是他那個會期所屬的委員會；同一個會期屬於不只一個委員會時，每一個都算。<strong
              class={term}>聯席會議</strong>只要會議單位裡有他的委員會，就算一場。
          </li>
          <li>開好幾天的會議算一場。</li>
          <li>
            三個比例的 n 是分母（場數或表決次數），套最小樣本：不到 5 時只顯示原始的值，不給百分位。四個計數的 n 就是值本身，不套最小樣本。
          </li>
        </ul>
      </div>

      <h4 id="profile-chamber-caucus" class={h4}>黨團多數</h4>
      <div class="prose-cn mt-2">
        <ul class={list}>
          <li>
            <strong class={term}>黨團多數</strong>是那一次表決裡，同一個黨團、有投票的委員中，票數最多的選項（贊成、反對或棄權）。算的時候包括他自己的票。
          </li>
          <li>
            兩個選項票數一樣多（並列）就是<strong class={term}>沒有多數</strong>：這一次不算進一致率，也不算跨黨投票。
          </li>
          <li>棄權也是一個選項：黨團多數投贊成而他棄權，算一次跟黨團不同。</li>
          <li>
            他屬於哪個黨團，看他那個會期任期上登記的黨團。沒有參加黨團的委員（例如無黨籍、沒有加入任何黨團）不算這兩項，頁面寫「沒有參加黨團」。
          </li>
        </ul>
      </div>
      <div class={formula}>
        <p class="text-[0.85rem] text-muted">
          例：某次表決，他的黨團有 51 人投票，48 人贊成、3 人反對，黨團多數是贊成。他投反對，就是一次跨黨投票；他沒有投票，這一次不在一致率的分母裡，但會讓投票出席率少一次。
        </p>
      </div>

      <h4 id="profile-chamber-reading" class={h4}>怎麼讀</h4>
      <div class="prose-cn mt-2">
        <ul class={list}>
          <li>
            <strong class={term}>出席、投票多不代表比較好。</strong>不出席、不投票可能是請假、公務，也可能是議事策略。
          </li>
          <li>
            <strong class={term}>跟黨團不一致也不代表好或壞。</strong>可能是選區的立場、個人的理念，也可能只是按錯。側寫只描述，不評價。
          </li>
          <li>
            <strong class={term}>提案多不代表立法成果多。</strong>一件提案可能只改一個字，也可能是一整部新法；三讀的法案也常是好幾個版本併在一起審的結果。
          </li>
        </ul>
      </div>

      <h4 id="profile-chamber-limits" class={h4}>限制</h4>
      <div class="prose-cn mt-2">
        <ul class={list}>
          <li>
            <strong class={term}>資料有延遲。</strong>立法院公布出席名單、公報與議案進度要時間，LYAPI 整理也要時間，我們又是每週才同步一次；最近幾週的紀錄可能還不完整，數字會變。
          </li>
          <li>
            <strong class={term}>出席看的是出席名單。</strong>名單上有他就算出席，不代表整場都在。
          </li>
          <li>
            <strong class={term}>聯席會議會讓分母變大。</strong>只要單位裡有他的委員會就算一場，所以他的委員會常開聯席會議時，委員會出席率的分母會比較大。他不是委員、只是去列席發言的委員會會議，不算進來。
          </li>
          <li>
            <strong class={term}>只算記名表決。</strong>口頭表決、舉手表決沒有逐人的紀錄，所以「投票出席率」是記名表決的出席率，不是所有表決的。
          </li>
          <li>
            <strong class={term}>三讀看的是議案狀態的文字。</strong>狀態寫著「三讀」才算。好幾個版本併案審查時，最後三讀的條文可能主要來自別的版本。
          </li>
          <li>
            <strong class={term}>只算委員提案。</strong>行政院與黨團提出的議案不算進任何人的主提案或連署。連署人在 LYAPI 的清單裡沒有，我們逐一查每位委員、每個會期的連署紀錄補上。
          </li>
          <li>
            <strong class={term}>名字要對得到。</strong>紀錄上的寫法跟名冊差太多時（例如異體字），那幾筆會對不到人，暫時不計入。
          </li>
          <li>
            <strong class={term}>為什麼沒有「提案與質詢一致率」。</strong>原本的構想是用議題分類器替每件提案分領域，再跟他質詢的議題比。但分類器是在質詢摘要上評估過的，議案名稱（「○○法第十七條條文修正草案」）是另一種文字，在上面準不準沒有驗過。照「模型參與的指標要先過人工標註」的原則，要先有一份議案名稱的人工標註集，所以這一項先不做。
          </li>
        </ul>
      </div>

      <!-- 聯合質詢 -->
      <h3 id="profile-joint" class={h3}>聯合質詢</h3>
      <div class="prose-cn">
        <ul class={list}>
          <li>
            <strong class={term}>投入量：</strong>每位講者各算一次發言；影片長度平分給每位講者。我們分不出誰講了多久，平分是唯一不用猜的算法。
          </li>
          <li>
            <strong class={term}>具體度：</strong>不計入任何一個人。摘要卡是整段的，分不出哪個數字、哪項要求是誰提的。
          </li>
          <li>
            <strong class={term}>議題分布：</strong>不分類、不計入任何一個人。一段聯合質詢裡每個人可能問不同的事，整段的領域不能算到每個人頭上。
          </li>
        </ul>
      </div>

      <!-- 百分位 -->
      <h3 id="profile-percentile" class={h3}>百分位</h3>
      <div class="prose-cn mt-3">
        <p>
          百分位回答「跟同儕比，他落在哪一段」。投入量的同儕是整個母體；具體度與議題分布的同儕是母體中這一項樣本足夠（n 至少 5）的人。
        </p>
      </div>
      <div class={formula}>
        <p>
          <span class={term}>百分位</span> ＝（同儕中值比他低的人數 ＋ 0.5 × 跟他同值的人數〔含他自己〕）÷ 同儕人數 × 100
        </p>
        <p class="mt-2 text-[0.85rem] text-muted">
          例：113 位同儕中，70 人的發言次數比他少，包括他在內有 2 人同值。（70 ＋ 0.5 × 2）÷ 113 × 100 ≈ 62.8，頁面顯示「第 63 百分位，在 113 位同儕中」。
        </p>
      </div>
      <div class="prose-cn">
        <ul class={list}>
          <li>同值的人拿到一樣的百分位，不會因為排列順序而多一點或少一點。</li>
          <li>同儕不到 5 人時，所有人的這一項都不給百分位，頁面寫「同儕不足，不比較」。</li>
          <li>
            長條上的圓點是他的位置，中間的刻度是第 50 百分位。長條不塗滿，因為百分位不是分數：發言次數在第 90 百分位，代表比九成的同儕多，不代表比較好。
          </li>
          <li>百分位以小數保存，頁面上四捨五入到整數。</li>
        </ul>
      </div>

      <!-- 最小樣本 -->
      <h3 id="profile-sample" class={h3}>最小樣本</h3>
      <div class="prose-cn mt-3">
        <p>
          具體度的三項指標與議題分布的三項指標（聚焦度、廣度、委員會職掌內的比例），分母（n）不到 <strong class={term}>5</strong> 時，不給百分位、不畫長條，只顯示原始的值與 n，並寫「樣本不足（需至少 5 篇）」；有來源占比的分母是數字個數，寫的是「需至少 5 個數字」。一兩篇算出來的比例起伏太大，拿去跟別人比只會誤導——只有 1 篇的人，聚焦度一定是 100%。
        </p>
        <p class="mt-3">
          投入量是計數、不是比例，沒有分母，所以不套最小樣本：發言 1 次的人一樣有百分位。但同儕不到 5 人時，投入量也不比較。
        </p>
        <p class="mt-3">
          院內紀錄的三個比例（出席率、投票出席率、與所屬黨團一致率）也套最小樣本，分母是場數或表決次數，寫「需至少 5 場」「需至少 5 次表決」；主提案、連署、三讀與跨黨投票是計數，不套。
        </p>
      </div>

      <!-- 資料限制 -->
      <h3 id="profile-limits" class={h3}>資料限制</h3>
      <div class="prose-cn">
        <ul class={list}>
          <li>
            <strong class={term}>只算已經完成的報導。</strong>還在處理中的影片不算，所以數字會隨處理進度變動。側寫上標有「計算於」的時間；每天晚上匯入新影片後重算一次。
          </li>
          <li>
            <strong class={term}>舊報導沒有摘要卡。</strong>摘要卡是後來才加的功能，舊報導要重新產生才會有，所以具體度的分母一開始會很小，很多人會先顯示「樣本不足」。
          </li>
          <li>
            <strong class={term}>「有來源」目前只等於「引用了法條，而且查得到條文原文」。</strong>見上面「具體度」。
          </li>
          <li>
            <strong class={term}>只涵蓋我們收錄的影片。</strong>來源是立法院 IVOD、臺中市議會與新北市議會公開的質詢影片；沒有公開或沒有被收錄的質詢不會算進來。
          </li>
          <li>
            <strong class={term}>名字要對得到名冊。</strong>講者的寫法跟議會名冊不同時（例如異體字），那幾篇暫時不計入，會在每天的計算報告裡列出來，由人工處理。
          </li>
          <li>
            <strong class={term}>摘要卡可能出錯。</strong>關鍵數字經過逐字稿比對，但「這是一項要求」「這是期限」是模型的判斷，仍可能誤判。逐字稿本身也可能有辨識錯誤。正式引用請以原始影音與公報為準。
          </li>
          <li>
            <strong class={term}>議題是模型分的。</strong>分類器要過人工標註的門檻才上線，但過了門檻仍會分錯；見上面「議題分布」的限制。
          </li>
          <li>
            <strong class={term}>院內紀錄每週才同步一次。</strong>立法院公布紀錄本來就有延遲，最近幾週的數字會變；見上面「院內紀錄」的限制。
          </li>
        </ul>
      </div>

      <!-- 還沒做的指標 -->
      <h3 id="profile-todo" class={h3}>還沒做的指標</h3>
      <div class="prose-cn mt-3">
        <p>
          側寫目前有投入量、具體度與議題分布三塊，立委另外有院內紀錄；議題分布要等那個議會的分類器通過評估才會出現。下面幾項在規劃中，做好之前不會出現在頁面上：
        </p>
        <ul class={list}>
          <li>
            <strong class={term}>市議員的出席率</strong>：各市議會公開的出席資料格式不一、多半不是結構化的，暫不做。立委的出席率已經在「院內紀錄」裡。
          </li>
          <li><strong class={term}>追問率</strong>：要求的期限過了以後，有沒有再追問同一件事。</li>
          <li>
            <strong class={term}>提案與質詢一致率</strong>（立委）：要先有一份議案名稱的人工標註集，議題分類器在議案名稱上過了門檻才做（見「院內紀錄」的限制）。
          </li>
        </ul>
        <p class="mt-4">
          不會做的：問政態度、選區服務、媒體聲量，以及任何形式的總分或排行榜。問政態度要靠主觀評價，交給模型判就成了網站的意見；選區服務與媒體聲量沒有公開的結構化資料；總分與排行榜違反第一條原則。
        </p>
      </div>
    </section>
  </div>
</Base>

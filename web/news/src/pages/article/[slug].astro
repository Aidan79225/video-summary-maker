---
import Base from '../../layouts/Base.astro';
import BriefCard from '../../components/BriefCard.astro';
import Notice from '../../components/Notice.astro';
import SlideBlock from '../../components/SlideBlock.astro';
import Transcript from '../../components/Transcript.astro';
import { getArticle, safeExternalUrl, statusFor } from '../../lib/api';
import { formatDateWithWeekday, humanDuration, mmss } from '../../lib/format';
import { articleTitle, isVideoSource, sourceSiteName } from '../../lib/sources';
import SourceBadge from '../../components/SourceBadge.astro';
import PartyBadge from '../../components/PartyBadge.astro';
import SpeakerChip from '../../components/SpeakerChip.astro';
import { basisLabel, buildCast, diarizationItems, markOf, NEUTRAL_NOTE } from '../../lib/speakers';

const slug = String(Astro.params.slug ?? '');
const res = slug ? await getArticle(slug) : null;

if (!res || !res.ok) {
  const kind = res?.ok === false ? res.error.kind : 'notfound';
  Astro.response.status = statusFor(kind);
}

const article = res && res.ok ? res.data : null;
// 影片（YouTube）不是議會的質詢：標題、長度、返回鍵、備註與頁尾的連結都要另外處理
const video = article ? isVideoSource(article.source) : false;
const title = article ? articleTitle(article.source, article.title) : '找不到報導';
const slides = article?.slides ?? [];
const ivodUrl = safeExternalUrl(article?.ivod_url);
const retryHref = Astro.url.pathname;
// 備註：影片固定先寫「這是 AI 整理的」並連回原影片，來源自己的說明（逐字稿怎麼來的）接在後面
const notes: { text: string; link?: { href: string; label: string } }[] = [];
if (video) {
  notes.push({
    text: '由 AI 依影片自動整理，可能有誤，以原影片為準。',
    link: ivodUrl ? { href: ivodUrl, label: `到 ${sourceSiteName(article?.source)} 看原影片` } : undefined,
  });
}
if (article?.source_note) notes.push({ text: article.source_note });

// 多人影片（用聲音區分說話者）：出場名單與辨識說明。只有影片才有；議會與單人影片
// 的 speakers 是空的、diarization 是 null，頁面一個字都不變。
// 說話者由網站「只顯示、不推測」——名字與標籤都是後端代好的，沒有人確認過的名字不會出現。
const cast = article && video ? buildCast(article.speakers) : undefined;
const multi = !!cast && cast.members.length > 0;
const diarization = article && video ? article.diarization : null;
const diarizationNotes = diarizationItems(diarization);
// 有出場名單、或後端有送辨識結果時，才顯示那一句固定的提醒
const showDiarization = multi || !!diarization;
---

<Base
  title={title}
  description={article?.teaser}
  back={true}
  backHref={video ? '/videos' : undefined}
  backLabel={video ? '回到影片' : undefined}
  noindex={video}
>
  {
    (!res || !res.ok) && (
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <Notice
          error={res && !res.ok ? res.error : { kind: 'notfound', message: '缺少文章代碼' }}
          retryHref={retryHref}
        />
      </div>
    )
  }

  {
    article && (
      <article class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
        <!-- 頁首 -->
        <header class="rise">
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5 text-sm">
            <a
              href={`/speaker/${encodeURIComponent(article.speaker)}?source=${article.source}`}
              class="lift rounded-full bg-accent-soft px-3 py-1 text-[0.82rem] font-medium wrap-anywhere text-accent-ink"
            >
              {multi && <span data-channel-label class="mr-1.5 text-[0.75rem] font-normal tracking-wider">頻道</span>}{article.speaker}
            </a>
            <PartyBadge party={article.party} />
            <SourceBadge source={article.source} />
            <time datetime={article.date} class="tabular text-muted">
              {formatDateWithWeekday(article.date)}
            </time>
          </div>

          <h1 class="headline mt-4 text-[1.7rem] font-semibold sm:text-4xl">{title}</h1>

          {/* 有摘要卡就用卡片，沒有才退回第一段的導言：兩個都放會講同一件事兩遍 */}
          {article.brief ? (
            <BriefCard brief={article.brief} source={article.source} />
          ) : (
            article.teaser && (
              <p class="prose-cn mt-5 border-l-2 border-accent/40 pl-4 text-[1.05rem] sm:text-[1.12rem]">
                {article.teaser}
              </p>
            )
          )}

          <dl class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-line-soft py-3 text-[0.8rem] text-muted">
            {article.party && (
              <div class="flex items-center gap-1.5">
                <dt class="text-muted/60">政黨</dt>
                <dd><PartyBadge party={article.party} full={true} /></dd>
              </div>
            )}
            {article.meeting && (
              <div class="flex items-center gap-1.5">
                <dt class="text-muted/60">會議</dt>
                <dd class="text-ink-2">{article.meeting}</dd>
              </div>
            )}
            {article.duration_seconds > 0 && (
              <div class="flex items-center gap-1.5">
                <dt class="text-muted/60">影片長度</dt>
                <dd class="tabular text-ink-2">
                  {humanDuration(article.duration_seconds)}（{mmss(article.duration_seconds)}）
                </dd>
              </div>
            )}
            <div class="flex items-center gap-1.5">
              <dt class="text-muted/60">重點段落</dt>
              <dd class="tabular text-ink-2">{slides.length} 段</dd>
            </div>
            <a
              href={ivodUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="lift ml-auto inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1 text-ink-2 hover:border-accent hover:text-accent"
            >
              <svg viewBox="0 0 24 24" class="h-3 w-3" fill="currentColor" aria-hidden="true">
                <path d="M8 5.5v13l11-6.5z" />
              </svg>
              觀看{sourceSiteName(article.source)}原片
            </a>
          </dl>

          {notes.map((n) => (
            <p class="mt-5 flex items-start gap-2.5 rounded-lg border-l-2 border-accent/50 bg-surface px-4 py-3 text-[0.8rem] leading-relaxed text-muted">
              <svg
                viewBox="0 0 24 24"
                class="mt-0.5 h-4 w-4 shrink-0 text-accent/80"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5" stroke-linecap="round" />
                <circle cx="12" cy="7.8" r="0.9" fill="currentColor" stroke="none" />
              </svg>
              <span>
                {n.text}
                {n.link && (
                  <a
                    href={n.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-1 text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
                  >
                    {n.link.label}
                  </a>
                )}
              </span>
            </p>
          ))}

          {/* 出場：這支影片裡區分出來的說話者。頻道（上傳者）是另一回事，只在最上面那顆。
              這裡不連到 /speaker/：「發言者 A」不是人，編輯設的名字也沒有名冊可以對 */}
          {
            multi && cast && (
              <section aria-labelledby="cast-h" class="mt-5 rounded-lg border border-line bg-surface px-4 py-4">
                <h2 id="cast-h" class="text-[0.7rem] tracking-[0.2em] text-muted uppercase">
                  出場
                </h2>
                <ul data-cast class="mt-3 space-y-2.5">
                  {cast.members.map((m) => (
                    <li
                      data-cast-item={m.ids[0]}
                      data-kind={m.kind}
                      data-basis={m.basis}
                      class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5"
                    >
                      <SpeakerChip mark={markOf(m, m.display)} />
                      {m.role && <span class="text-[0.82rem] text-ink-2">{m.role}</span>}
                      <span
                        data-basis-chip
                        class:list={[
                          'rounded-full border px-2 py-0.5 text-[0.7rem] leading-snug',
                          m.basis === 'operator' ? 'border-accent/50 text-accent-ink' : 'border-line text-muted',
                        ]}
                      >
                        {basisLabel(m.basis)}
                      </span>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {/* 辨識說明：固定的一句提醒；狀態是 warn 時，每個警告碼再加一句白話。不顯示任何數字 */}
          {
            showDiarization && (
              <section
                role="note"
                aria-label="說話者辨識說明"
                data-diarization={diarization ? diarization.status : 'none'}
                class:list={[
                  'mt-3 flex items-start gap-2.5 rounded-lg border-l-2 bg-surface px-4 py-3 text-[0.8rem] leading-relaxed text-muted',
                  diarizationNotes.length > 0 ? 'border-accent' : 'border-accent/50',
                ]}
              >
                <svg
                  viewBox="0 0 24 24"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent/80"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 11v5" stroke-linecap="round" />
                  <circle cx="12" cy="7.8" r="0.9" fill="currentColor" stroke="none" />
                </svg>
                <div class="min-w-0">
                  <p data-neutral-note>{NEUTRAL_NOTE}</p>
                  {diarizationNotes.length > 0 && (
                    <ul data-warnings class="mt-2 list-disc space-y-1 pl-5 text-ink-2">
                      {diarizationNotes.map((w) => (
                        <li data-warning={w.code}>{w.text}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>
            )
          }
        </header>

        <!-- 逐段內容：完整敘述預設收合，這一列可以一次展開 -->
        {slides.some((s) => s.detail) && (
          <div class="mt-10 flex flex-wrap items-center gap-3 text-[0.8rem] text-muted sm:mt-14">
            <button
              type="button"
              id="toggle-details"
              data-open-label="展開全部敘述"
              data-close-label="收合全部敘述"
              class="lift rounded-full border border-line bg-surface px-4 py-1.5 text-ink-2 hover:border-accent hover:text-accent"
            >
              展開全部敘述
            </button>
            <span>預設只看小標與條列，完整敘述按需要展開。</span>
          </div>
        )}
        {slides.length > 0 ? (
          <div class="mt-6 space-y-10 sm:mt-8 sm:space-y-12">
            {slides.map((s, i) => (
              <SlideBlock
                slide={s}
                ivodUrl={ivodUrl}
                source={article.source}
                order={i + 1}
                total={slides.length}
                cast={cast}
              />
            ))}
          </div>
        ) : (
          <div class="mt-12">
            <Notice
              title="這篇還沒有分段重點"
              body="後端沒有回傳任何段落。你仍然可以展開下方的完整逐字稿，或直接觀看原片。"
              retryHref={retryHref}
            />
          </div>
        )}

        <!-- 完整逐字稿 -->
        <Transcript text={article.transcript_text} sourceNote={article.source_note} cast={cast} />

        <!-- 後續導覽 -->
        <nav class="mt-12 flex flex-wrap gap-3 border-t border-line-soft pt-8 text-sm">
          <a
            href={`/speaker/${encodeURIComponent(article.speaker)}?source=${article.source}`}
            class="lift rounded-full border border-line bg-surface px-4 py-2 wrap-anywhere hover:border-accent hover:text-accent"
          >
            看 {article.speaker} 的其他{video ? '影片' : '報導'}
          </a>
          {
            video ? (
              <a
                href="/videos"
                class="lift rounded-full border border-line px-4 py-2 text-muted hover:border-accent hover:text-accent"
              >
                看所有影片
              </a>
            ) : (
              <a
                href={`/?date=${encodeURIComponent(article.date)}`}
                class="lift rounded-full border border-line px-4 py-2 text-muted hover:border-accent hover:text-accent"
              >
                看 {article.date} 的所有報導
              </a>
            )
          }
        </nav>
      </article>
    )
  }

  <script is:inline>
    (function () {
      var btn = document.getElementById('toggle-details');
      if (!btn) return;
      var all = function () {
        return Array.prototype.slice.call(document.querySelectorAll('details[data-detail]'));
      };
      var sync = function () {
        var open = all().length > 0 && all().every(function (d) { return d.open; });
        btn.textContent = open ? btn.dataset.closeLabel : btn.dataset.openLabel;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      btn.addEventListener('click', function () {
        var open = !all().every(function (d) { return d.open; });
        all().forEach(function (d) { d.open = open; });
        sync();
      });
      // 個別展開到全部都開時，按鈕也要跟著變成「收合」
      document.addEventListener('toggle', function (e) {
        if (e.target && e.target.matches && e.target.matches('details[data-detail]')) sync();
      }, true);
      sync();
    })();
  </script>
</Base>

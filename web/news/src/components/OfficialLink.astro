---
/**
 * 紀錄清單上每一筆的官方連結（立法院議事暨公報資訊網）。
 *
 * 網址來自上游，只接受 http(s)：跟 ivod_url 同一個理由，javascript: 會變成點擊型 XSS。
 * 不合格或沒給就什麼都不畫，不留一個點了沒反應的字。另開新視窗，讀者看完官方資料
 * 還回得來；連結文字只有「官方紀錄」，所以用 aria-label 補上是哪一筆，報讀器
 * 列出整頁連結時才分得出來。
 */
import { safeExternalUrl } from '../lib/api';

interface Props {
  url: string;
  /** 這一筆的名稱，寫進 aria-label */
  label: string;
}

const { url, label } = Astro.props;
const href = safeExternalUrl(url);
---

{
  href && (
    <a
      href={href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${label}：官方紀錄（另開新視窗）`}
      class="group inline-flex shrink-0 items-center gap-1 text-[0.75rem] whitespace-nowrap text-accent"
    >
      <span class="underline decoration-accent/40 underline-offset-4 transition-colors group-hover:decoration-accent">
        官方紀錄
      </span>
      <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M14 5h5v5M19 5l-8 8M10 6H6a1 1 0 0 0-1 1v11a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  )
}

---
import { isFixtureMode } from '../lib/api';

const year = new Date().getFullYear();
const fixture = isFixtureMode();
---

<footer class="mt-20 border-t border-line-soft bg-bg-soft">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-md">
        <p class="headline text-base font-semibold">質詢日報</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          內容整理自立法院 IVOD、臺中市議會隨選視訊與新北市議會議事影音公開的質詢影片。立法院的逐字稿由院方 AI 產生，
          臺中市議會與新北市議會的由本站語音辨識產生，都可能有辨識錯誤；摘要為自動整理，正式引用請以原始影音與公報為準。
        </p>
        <p class="mt-3 text-sm">
          <a
            href="/method"
            class="text-ink-2 underline decoration-line underline-offset-4 transition-colors hover:text-accent"
          >
            方法說明：人物側寫的指標怎麼算
          </a>
        </p>
      </div>
      <div class="text-sm text-muted">
        <p>
          <a
            href="https://ivod.ly.gov.tw/"
            rel="noopener noreferrer"
            target="_blank"
            class="underline decoration-line underline-offset-4 transition-colors hover:text-accent"
          >
            立法院隨選視訊（IVOD）
          </a>
        </p>
        <p class="mt-1">
          <a
            href="https://vod.tccc.gov.tw/"
            rel="noopener noreferrer"
            target="_blank"
            class="underline decoration-line underline-offset-4 transition-colors hover:text-accent"
          >
            臺中市議會議員質詢隨選視訊
          </a>
        </p>
        <p class="mt-1">
          <a
            href="https://vod.ntp.gov.tw/VodCloudV2/"
            rel="noopener noreferrer"
            target="_blank"
            class="underline decoration-line underline-offset-4 transition-colors hover:text-accent"
          >
            新北市議會議事影音隨選視訊
          </a>
        </p>
        <p class="mt-2 text-xs break-all text-muted/70">
          {fixture ? '資料來源：示範資料（src/fixtures/sample.json）' : '資料來源：立法院 IVOD、臺中市議會隨選視訊、新北市議會議事影音'}
        </p>
      </div>
    </div>
    <p class="mt-8 text-xs text-muted/60">© {year} 質詢日報</p>
  </div>
</footer>

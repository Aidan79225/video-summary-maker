# 複製成 .env（docker compose 會自動讀）。.env 已經在 .gitignore 裡，不會進版控。

# --- 一定要填 ---
# 產生方式：python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# GPU 主機上的摘要 API（serve_api.py）。要用區網 IP，不能寫 localhost——那會指到容器自己。
GPU_API_BASE=http://192.168.1.50:8800
GPU_API_KEY=
# 截圖網址的開頭，會原樣送到讀者的瀏覽器。
#   只在區網：http://pi.local:8000
#   走 Cloudflare：https://news.example.com
PUBLIC_MEDIA_BASE=http://pi.local:8000

# --- 視情況 ---
# 讀者會用來連 Django 的主機名（逗號分隔）。走 Cloudflare 時把網域加進來。
PUBLIC_HOSTS=pi.local
# Cloudflare Tunnel 的 token（Zero Trust → Networks → Tunnels 建立 tunnel 時給的）
TUNNEL_TOKEN=

# --- 通常不用動 ---
INGEST_DAILY_LIMIT=20
INGEST_HOUR=4
WEB_PORT=4321
API_PORT=8000

# 用 Portainer 部署：把這些變數填進 stack 的「Environment variables」表單（可以直接貼整份）。
# 用命令列：複製成 .env（docker compose 會自動讀）。.env 已經在 .gitignore 裡，不會進版控。

# --- 一定要填 ---
# 資料庫與截圖放在 Pi 的磁碟陣列上（和其他 stack 一樣放 appdata/ 底下）。
# 第一次要先建好並交給 uid 1000：sudo mkdir -p <路徑> && sudo chown -R 1000:1000 <路徑>
DATA_DIR=/srv/dev-disk-by-uuid-c5864524-54ad-43a7-80c5-01c34933f352/appdata/ly-news
# 產生方式：python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# GPU 主機上的摘要 API（serve_api.py）。要用區網 IP，不能寫 localhost——那會指到容器自己。
GPU_API_BASE=http://192.168.1.50:8800
GPU_API_KEY=
# 截圖網址的開頭，會原樣送到讀者的瀏覽器。
#   走 Cloudflare：https://news.aidan.tw
#   只在區網：http://pi.local:8000
PUBLIC_MEDIA_BASE=https://news.aidan.tw
# 讀者會用來連 Django 的主機名（逗號分隔）：網域，加上區網位址。
PUBLIC_HOSTS=news.aidan.tw,pi.local
# Cloudflare Tunnel 的 token（和 Pi 上其他 stack 用同一條 tunnel、同一把 token）
CLOUDFLARE_TUNNEL_TOKEN=

# --- 通常不用動 ---
INGEST_DAILY_LIMIT=20
INGEST_HOUR=4
WEB_PORT=4321
API_PORT=8000

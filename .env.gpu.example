# GPU 主機的 compose 設定。複製成 .env.gpu（已在 .gitignore），用
#   docker compose -f compose.gpu.yaml --env-file .env.gpu up -d --build

# 對外的 API key。Pi 那邊的 GPU_API_KEY 要填同一把。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
SLIDEBOX_API_KEY=

# Windows 上 Ollama 的資料夾（裡面有 models/）。用正斜線。
OLLAMA_MODELS_DIR=C:/Users/Aidan/.ollama

# 通常不用動
SLIDEBOX_MODEL=qwen3.5:9b
# 語音辨識裝置：auto（預設，有顯示卡就用）、cpu、cuda
SLIDEBOX_WHISPER_DEVICE=auto
API_PORT=8800

# --- YouTube 多人說話者區分（speaker_mode=diarize）---
# 一次性的設定（這個檔案已在 .gitignore，token 只放在這裡，不要貼到別的地方）：
#   1. 到 https://huggingface.co/settings/tokens 建一個唯讀（Read）的 token，填在底下
#   2. 用同一個 Hugging Face 帳號，到 https://huggingface.co/pyannote/speaker-diarization-community-1
#      按下接受使用條款；沒接受的話，載入模型時會被拒絕
# 第一次跑多人工作會下載模型（存在 whisper-cache volume，只下載一次）。詳細說明見 README 的「多人說話者模式」。
HUGGINGFACE_TOKEN=
# pyannote（預設）：啟用；off：關掉多人模式，Pi 的 add_video 會在寫入資料庫前失敗
SLIDEBOX_DIARIZER=pyannote
# 說話者區分的裝置：auto（預設，有顯示卡就用，載不起來退回 CPU）、cpu、cuda
# 驅動太舊、跟映像裡的 CUDA 版本（鎖檔裡的 torch 是 CUDA 13）對不上，或顯示卡記憶體不夠時，
# 設成 cpu 就完全不碰 CUDA（比較慢）
SLIDEBOX_DIARIZATION_DEVICE=auto
# 多人對談切窗的字數預算（1000～20000）。留空或超出範圍就用程式裡的預設值，通常不用動
SLIDEBOX_CHUNK_CHARS=
